OPENAI_API_KEY=
OPENAI_MODEL_MAIN=
OPENAI_MODEL_FAST=
OPENAI_EMBEDDING_MODEL=
TELEGRAM_BOT_TOKEN=
# Фаза 5b: исходящие system notifications только в control group (тот же бот; без polling/webhook Studio)
STUDIO_SYSTEM_NOTIFICATIONS_ENABLED=false
STUDIO_TELEGRAM_SEND_TIMEOUT_MS=3000
STUDIO_SYSTEM_NOTIFICATION_MAX_RETRIES=3
# Фазы 6b–6c: шаблонная генерация summary_text; продуктовые POST/GET /summaries/chat/... требуют STUDIO_SUMMARY_GENERATION_ENABLED=true и STUDIO_ADMIN_TOKEN (без внешнего LLM; без отправки сводок в Telegram)
STUDIO_SUMMARY_GENERATION_ENABLED=false
STUDIO_SUMMARY_MAX_SOURCE_MESSAGES=200
STUDIO_SUMMARY_MAX_BULLETS=20
# Фаза 6d: доставка готовых сводок в Telegram control group (sendMessage; тот же бот)
STUDIO_SUMMARY_DELIVERY_ENABLED=false
STUDIO_SUMMARY_DELIVERY_MAX_RETRIES=3
# Фаза 7a: команды /summary_* из control group по зеркалу Event Mirror (скан studio_messages; без второго бота; без polling/webhook Studio)
STUDIO_CONTROL_COMMANDS_ENABLED=false
STUDIO_CONTROL_COMMANDS_MAX_BATCH=50
# Фаза 7b: ACL команд в control group по Telegram user id (CSV/пробелы/;). Пусто — все участники чата.
STUDIO_CONTROL_COMMANDS_ALLOWED_USER_IDS=
# Фаза 8a: SLA по зеркалу studio_messages (client_chat / project_chat), без LLM; уведомления только в control group
STUDIO_SLA_ENABLED=false
STUDIO_SLA_DEFAULT_FIRST_RESPONSE_MINUTES=60
STUDIO_SLA_MAX_NOTIFICATIONS_PER_INCIDENT=3
STUDIO_SLA_DEFAULT_TIMEZONE=UTC
STUDIO_SLA_WORKING_HOURS_ENABLED=false
# Фаза 8c: антиспам SLA-уведомлений в control group (cooldown, digest, audit studio_sla_notification_events)
STUDIO_SLA_NOTIFICATION_COOLDOWN_MINUTES=30
STUDIO_SLA_NOTIFICATION_DIGEST_MAX_ITEMS=10
STUDIO_SLA_NOTIFICATION_TEXT_MAX_LEN=3500
# Фаза 10a: база знаний в Studio DB (документы/версии/чанки; без embeddings/LLM/RAG)
STUDIO_KB_ENABLED=false
STUDIO_KB_CHUNK_MAX_CHARS=2000
STUDIO_KB_CHUNK_OVERLAP_CHARS=200
# Фаза 10c: эмбеддинги чанков (deterministic, без LLM) + vector search (pgvector в Postgres; SQLite — fallback)
STUDIO_KB_EMBEDDINGS_ENABLED=false
STUDIO_KB_EMBEDDING_MODEL=deterministic
STUDIO_KB_EMBEDDING_DIM=384
STUDIO_KB_SEARCH_TOP_K=5
STUDIO_SECRET_KEY=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# Studio Layer (async SQLAlchemy + Alembic sync URL derived in code)
DATABASE_URL=postgresql+asyncpg://pb_studio:pb_studio_dev@127.0.0.1:5433/pb_studio
REDIS_URL=redis://127.0.0.1:6380/0
CELERY_BROKER_URL=redis://127.0.0.1:6380/1
CELERY_RESULT_BACKEND=
STUDIO_ENV=local
STUDIO_EVENTS_INGEST_TOKEN=
# Memoh → Studio Event Mirror (фаза 4b, вариант C): POST сырого Telegram Update на Studio
STUDIO_EVENTS_URL=
MEMOH_TELEGRAM_EVENT_MIRROR_ENABLED=false
MEMOH_TELEGRAM_EVENT_MIRROR_TIMEOUT_MS=1000
# Опционально: отдельный токен для Memoh; иначе используется STUDIO_EVENTS_INGEST_TOKEN
MEMOH_STUDIO_EVENTS_TOKEN=
STUDIO_MIRROR_ENQUEUE_USER_MESSAGES=false
# Studio API: защита админ-роутов (control group, чаты, сводки, SLA, проекты /projects, база знаний /knowledge); пусто — без Bearer в локалке
STUDIO_ADMIN_TOKEN=
STUDIO_BASE_URL=
MEMOH_BASE_URL=
DOMAIN=memo.pb-web.ru
