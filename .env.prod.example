# =============================================================================
# Studio production — шаблон переменных (НЕ коммитить копию с секретами как .env.prod).
# Скопируйте: cp .env.prod.example .env.prod
# Подстановка в compose: docker compose --env-file .env.prod -f docker-compose.prod.yml up -d
#
# Обязательно перед продом:
#   - смените POSTGRES_PASSWORD и пароль в DATABASE_URL (или задайте DATABASE_URL целиком);
#   - задайте STUDIO_ADMIN_TOKEN (случайная длинная строка);
#   - задайте TELEGRAM_BOT_TOKEN если нужны исходящие сообщения / KB Telegram import.
# =============================================================================

# --- Compose / Postgres (хост studio-postgres внутри docker-сети) ---
POSTGRES_DB=pb_studio
POSTGRES_USER=pb_studio
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD

# asyncpg URL для приложения (должен совпадать с пользователем/БД выше)
DATABASE_URL=postgresql+asyncpg://pb_studio:CHANGE_ME_STRONG_POSTGRES_PASSWORD@studio-postgres:5432/pb_studio

REDIS_URL=redis://studio-redis:6379/0
CELERY_BROKER_URL=redis://studio-redis:6379/1
# Опционально: отдельный backend для результатов Celery (пусто = broker)
CELERY_RESULT_BACKEND=

STUDIO_ENV=production

# Публикация API на хосте: host_ip:host_port до последнего «:8000» контейнера (см. docker-compose.prod.yml)
# STUDIO_DOCKER_PUBLISH=127.0.0.1:8000

# --- Безопасность Studio API ---
# ОБЯЗАТЕЛЬНО в prod: токен для /admin/*, админ JSON API, history-import и т.д.
STUDIO_ADMIN_TOKEN=

# Опционально: Bearer для POST /events/telegram (ингест Memoh / зеркало)
STUDIO_EVENTS_INGEST_TOKEN=
STUDIO_MIRROR_ENQUEUE_USER_MESSAGES=false

# --- Telegram (тот же бот; Studio не поднимает polling/webhook) ---
# ОБЯЗАТЕЛЬНО если включены уведомления, доставка сводок, SLA notify, system notifications, KB import из Telegram
TELEGRAM_BOT_TOKEN=

STUDIO_SYSTEM_NOTIFICATIONS_ENABLED=false
STUDIO_TELEGRAM_SEND_TIMEOUT_MS=3000
STUDIO_SYSTEM_NOTIFICATION_MAX_RETRIES=3

# --- Сводки ---
STUDIO_SUMMARY_GENERATION_ENABLED=false
STUDIO_SUMMARY_MAX_SOURCE_MESSAGES=200
STUDIO_SUMMARY_MAX_BULLETS=20
STUDIO_SUMMARY_DELIVERY_ENABLED=false
STUDIO_SUMMARY_DELIVERY_MAX_RETRIES=3

# --- Команды из control group (/summary_* и др.) ---
STUDIO_CONTROL_COMMANDS_ENABLED=false
STUDIO_CONTROL_COMMANDS_MAX_BATCH=50
STUDIO_CONTROL_COMMANDS_ALLOWED_USER_IDS=

# --- SLA ---
STUDIO_SLA_ENABLED=false
STUDIO_SLA_DEFAULT_FIRST_RESPONSE_MINUTES=60
STUDIO_SLA_MAX_NOTIFICATIONS_PER_INCIDENT=3
STUDIO_SLA_DEFAULT_TIMEZONE=UTC
STUDIO_SLA_WORKING_HOURS_ENABLED=false
STUDIO_SLA_NOTIFICATION_COOLDOWN_MINUTES=30
STUDIO_SLA_NOTIFICATION_DIGEST_MAX_ITEMS=10
STUDIO_SLA_NOTIFICATION_TEXT_MAX_LEN=3500

# --- Импорт истории (Telegram Desktop JSON) ---
STUDIO_HISTORY_IMPORT_ENABLED=false
STUDIO_HISTORY_IMPORT_MAX_BYTES=52428800

# --- База знаний (KB) ---
STUDIO_KB_ENABLED=false
STUDIO_KB_CHUNK_MAX_CHARS=2000
STUDIO_KB_CHUNK_OVERLAP_CHARS=200
STUDIO_KB_EMBEDDINGS_ENABLED=false
STUDIO_KB_EMBEDDING_MODEL=deterministic
STUDIO_KB_EMBEDDING_DIM=384
STUDIO_KB_SEARCH_TOP_K=5
STUDIO_KB_EMBEDDING_PROVIDER=deterministic
# OpenAI-compatible embeddings (если STUDIO_KB_EMBEDDING_PROVIDER=openai_compatible)
STUDIO_KB_EMBEDDING_API_BASE_URL=
STUDIO_KB_EMBEDDING_API_KEY=
STUDIO_KB_EMBEDDING_TIMEOUT_MS=10000
STUDIO_KB_EMBEDDING_BATCH_SIZE=32

# RAG (chat completion) — ключи не коммитить; оставьте пустым если STUDIO_KB_RAG_ENABLED=false
STUDIO_KB_RAG_ENABLED=false
STUDIO_KB_CHAT_PROVIDER=openai_compatible
STUDIO_KB_CHAT_API_BASE_URL=
STUDIO_KB_CHAT_API_KEY=
STUDIO_KB_CHAT_MODEL=
STUDIO_KB_CHAT_TIMEOUT_MS=20000
STUDIO_KB_RAG_TOP_K=5
STUDIO_KB_RAG_MAX_CONTEXT_CHARS=8000

STUDIO_KB_DOCLING_ENABLED=false
STUDIO_KB_UPLOAD_MAX_BYTES=10485760
STUDIO_KB_ALLOWED_EXTENSIONS=txt,md,pdf,docx
STUDIO_KB_STORAGE_DIR=/app/storage/kb

STUDIO_KB_TELEGRAM_IMPORT_ENABLED=false
STUDIO_KB_TELEGRAM_DOWNLOAD_TIMEOUT_MS=10000
STUDIO_KB_TELEGRAM_MAX_FILE_BYTES=0

# =============================================================================
# Прочие ключи (не используются самим Studio compose, но могут быть в общем .env на сервере)
# =============================================================================
OPENAI_API_KEY=
OPENAI_MODEL_MAIN=
OPENAI_MODEL_FAST=
OPENAI_EMBEDDING_MODEL=
