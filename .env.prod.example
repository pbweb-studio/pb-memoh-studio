# =============================================================================
# Studio production — шаблон .env.prod (НЕ коммитить файл с реальными секретами).
#   cp .env.prod.example .env.prod
#   python3 deploy/scripts/validate_env_prod.py .env.prod
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d
#
# Маркировка:
#   [REQUIRED]   — обязательно задать перед первым prod-запуском (см. validate_env_prod.py).
#   [optional]   — можно оставить по умолчанию или пустым, если не используете функцию.
#   [secret]     — храните только в .env.prod / секрет-хранилище; в git не коммитить.
# =============================================================================

# -----------------------------------------------------------------------------
# [REQUIRED] Postgres + приложение (секреты в проде не должны совпадать с dev-дефолтами compose)
# -----------------------------------------------------------------------------
POSTGRES_DB=pb_studio
POSTGRES_USER=pb_studio
# [REQUIRED][secret] Сильный пароль; не используйте значение из dev-compose.
POSTGRES_PASSWORD=
# [REQUIRED][secret] asyncpg URL; пользователь/БД/пароль совпадают с POSTGRES_* выше.
DATABASE_URL=

REDIS_URL=redis://studio-redis:6379/0
CELERY_BROKER_URL=redis://studio-redis:6379/1
# [optional] Отдельный backend результатов Celery (пусто = broker)
CELERY_RESULT_BACKEND=

STUDIO_ENV=production

# [optional] Публикация API на хосте: host:host_port:8000 (см. docker-compose.prod.yml STUDIO_DOCKER_PUBLISH)
# STUDIO_DOCKER_PUBLISH=127.0.0.1:8000:8000

# -----------------------------------------------------------------------------
# [REQUIRED][secret] Админка / JSON API под Bearer (длина ≥ 32 символов рекомендуется)
# -----------------------------------------------------------------------------
STUDIO_ADMIN_TOKEN=

# [optional][secret] Bearer для POST /events/telegram (если пусто — проверка ingest отключена)
STUDIO_EVENTS_INGEST_TOKEN=
# [optional] Класть user messages в Response Queue при зеркалировании
STUDIO_MIRROR_ENQUEUE_USER_MESSAGES=false

# -----------------------------------------------------------------------------
# [optional][secret] Telegram Bot API — ОБЯЗАТЕЛЕН, если включены исходящие сценарии в Telegram
# (system notifications, summary delivery, SLA notify, KB import из Telegram и т.д.)
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=

# -----------------------------------------------------------------------------
# Feature flags — только true/false (или 1/0). Включайте по одному после smoke.
# Зависимости: см. docs/08_RUNBOOK_PRODUCTION.md и validate_env_prod.py
# -----------------------------------------------------------------------------
# Исходящие system notifications в control group
STUDIO_SYSTEM_NOTIFICATIONS_ENABLED=false
STUDIO_TELEGRAM_SEND_TIMEOUT_MS=3000
STUDIO_SYSTEM_NOTIFICATION_MAX_RETRIES=3

# Сводки: генерация / доставка в Telegram (доставка требует TELEGRAM_BOT_TOKEN)
STUDIO_SUMMARY_GENERATION_ENABLED=false
STUDIO_SUMMARY_MAX_SOURCE_MESSAGES=200
STUDIO_SUMMARY_MAX_BULLETS=20
STUDIO_SUMMARY_DELIVERY_ENABLED=false
STUDIO_SUMMARY_DELIVERY_MAX_RETRIES=3

# Команды из control group (/summary_*, /kb_ask, …)
STUDIO_CONTROL_COMMANDS_ENABLED=false
STUDIO_CONTROL_COMMANDS_MAX_BATCH=50
# Список telegram user id через запятую (пусто = без ACL по пользователю — уточните политику)
STUDIO_CONTROL_COMMANDS_ALLOWED_USER_IDS=

# SLA
STUDIO_SLA_ENABLED=false
STUDIO_SLA_DEFAULT_FIRST_RESPONSE_MINUTES=60
STUDIO_SLA_MAX_NOTIFICATIONS_PER_INCIDENT=3
STUDIO_SLA_DEFAULT_TIMEZONE=UTC
STUDIO_SLA_WORKING_HOURS_ENABLED=false
STUDIO_SLA_NOTIFICATION_COOLDOWN_MINUTES=30
STUDIO_SLA_NOTIFICATION_DIGEST_MAX_ITEMS=10
STUDIO_SLA_NOTIFICATION_TEXT_MAX_LEN=3500

# Импорт истории Telegram Desktop JSON → Event Mirror
STUDIO_HISTORY_IMPORT_ENABLED=false
STUDIO_HISTORY_IMPORT_MAX_BYTES=52428800

# База знаний (KB)
STUDIO_KB_ENABLED=false
STUDIO_KB_CHUNK_MAX_CHARS=2000
STUDIO_KB_CHUNK_OVERLAP_CHARS=200
STUDIO_KB_EMBEDDINGS_ENABLED=false
STUDIO_KB_EMBEDDING_MODEL=deterministic
STUDIO_KB_EMBEDDING_DIM=384
STUDIO_KB_SEARCH_TOP_K=5
STUDIO_KB_EMBEDDING_PROVIDER=deterministic
# При STUDIO_KB_EMBEDDINGS_ENABLED=true и provider=openai_compatible — [REQUIRED] URL и ключ
STUDIO_KB_EMBEDDING_API_BASE_URL=
STUDIO_KB_EMBEDDING_API_KEY=
STUDIO_KB_EMBEDDING_TIMEOUT_MS=10000
STUDIO_KB_EMBEDDING_BATCH_SIZE=32

# RAG: при STUDIO_KB_RAG_ENABLED=true — [REQUIRED] STUDIO_KB_CHAT_* (base URL, key, model)
STUDIO_KB_RAG_ENABLED=false
STUDIO_KB_CHAT_PROVIDER=openai_compatible
STUDIO_KB_CHAT_API_BASE_URL=
STUDIO_KB_CHAT_API_KEY=
STUDIO_KB_CHAT_MODEL=
STUDIO_KB_CHAT_TIMEOUT_MS=20000
STUDIO_KB_RAG_TOP_K=5
STUDIO_KB_RAG_MAX_CONTEXT_CHARS=8000

STUDIO_KB_DOCLING_ENABLED=false
STUDIO_KB_UPLOAD_MAX_BYTES=10485760
STUDIO_KB_ALLOWED_EXTENSIONS=txt,md,pdf,docx
STUDIO_KB_STORAGE_DIR=/app/storage/kb

# Импорт документов в KB из Telegram (требует TELEGRAM_BOT_TOKEN)
STUDIO_KB_TELEGRAM_IMPORT_ENABLED=false
STUDIO_KB_TELEGRAM_DOWNLOAD_TIMEOUT_MS=10000
STUDIO_KB_TELEGRAM_MAX_FILE_BYTES=0

# -----------------------------------------------------------------------------
# [optional] Прочие ключи (не обязательны для compose Studio; внешние интеграции)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL_MAIN=
OPENAI_MODEL_FAST=
OPENAI_EMBEDDING_MODEL=
